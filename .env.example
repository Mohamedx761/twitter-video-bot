# Telegram Bot Token - Get it from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# Your Telegram User ID - The bot will only work for this user
# To get your ID, message @userinfobot on Telegram
AUTHORIZED_USER_ID=your_user_id_here

# Download directory (optional)
DOWNLOAD_DIR=./downloads

# Cookies file for Twitter/X (optional, but recommended)
# If you want to download age-restricted or protected videos,
# you need to export cookies from your browser.
# COOKIES_FILE=cookies.txt
